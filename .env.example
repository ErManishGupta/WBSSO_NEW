# Application Environment
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
WEB_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wb_sso?schema=public

# Session & Security
SESSION_SECRET=wb_sso_super_secure_session_secret_change_in_production_2026
SESSION_MAX_AGE_MS=86400000
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# Mock OTP Settings (Dev flag)
MOCK_OTP_ENABLED=true
MOCK_OTP_CODE=123456

# RSA Keypaths for RS256 SSO Handoff Tokens
KEY_DIR=./keys

# Mock Portals
FACTORY_PORTAL_PORT=4001
FACTORY_PORTAL_URL=http://localhost:4001
PORTAL_B_PORT=4002
PORTAL_B_URL=http://localhost:4002

# Feature Flags
VITE_ENABLE_AI_ASSISTANT=false
